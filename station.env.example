# Settings for this machine. Copy to station.env (never committed) and edit. Every line is optional: with none set,
# everything (camera program, station, page) is expected on this one machine. A value already in the environment wins.
# "~" is expanded.

# Where the camera program (camera/stereo_stream.py) answers. Leave unset when it runs on this machine.
# On a Mac, with the camera plugged into a Pi or a Linux PC:
# STATION_CAMERA_URL=http://<camera machine address>:8090

# Python that runs the arm programs, the picture check and the solver (it needs lerobot, opencv-python, numpy).
# Default: the Python that starts the station.
# STATION_PY=~/path/to/venv/bin/python

# Runtime data: recordings (runs/), the session log, results, settings (station/). Keep it outside the repo.
# STATION_DATA=~/so101-station-data

# This station's name on the page and in the session log. Default: this machine's host name.
# STATION_NAME=station-1

# Ports and where the page listens (0.0.0.0 to open it from another device on the network).
# STATION_PORT=18772
# DASH_PORT=18771
# DASH_BIND=127.0.0.1

# A board other than 12 x 9 squares of 30 mm with 22 mm DICT_5X5_1000 markers (see station/board.py).
# STATION_BOARD={"squares_x": 12, "squares_y": 9, "square_m": 0.030, "marker_m": 0.022, "dictionary": "DICT_5X5_1000"}

# Arm control boards (also settable in arm/arm.json; see arm/so101_host.py). With one board plugged in, it is found
# by its USB id and taken as the follower; with two, give at least the follower's USB serial.
# SO101_FOLLOWER_SERIAL=<serial printed by: python arm/so101_host.py>
# SO101_LEADER_SERIAL=<serial>
# SO101_FOLLOWER_PORT=/dev/ttyACM0
# SO101_PROFILE=~/path/to/follower-calibration.json

# Video decoding for the solver: videotoolbox is used on a Mac by default; on a Pi try drm. Empty = software.
# DECODE_HWACCEL=drm

# Speech cues ("Recording A. Keep clear."): 0 turns them off.
# STATION_SPEECH=1

# Camera program settings (on the camera machine).
# CAMERA_DEVICE=/dev/video0
# CAMERA_SIZE=3840x1200
# CAMERA_FPS=30
# CAMERA_ID=<a unique id for the camera now plugged in, when its USB serial is not unique>
# When the camera program runs on the same machine as the station, link recordings instead of copying them:
# STATION_LOCAL_REC=~/stereo-frames/rec
